<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/cardview_bg"
    android:layout_marginBottom="4dp"
    android:padding="8dp"
    android:weightSum="5"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/item_count_id"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_gravity="center_vertical"
        android:background="@drawable/stroke_background"
        android:layout_weight="1"
        android:padding="8dp"
        android:gravity="center"
        android:text="1"
        android:textStyle="bold"
        android:textColor="@color/cnl_color_1"
        android:textSize="30dp">

    </TextView>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_weight="3"
        android:layout_marginLeft="8dp"
        android:gravity="center_vertical"
        android:orientation="vertical">
        <TextView
            android:id="@+id/route_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Market Name"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:textSize="13sp">
        </TextView>
        <TextView
            android:id="@+id/territory_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Territory Name"
            android:textColor="@color/text_title"
            android:textStyle="bold"
            android:textSize="9sp">
        </TextView>
        <TextView
            android:id="@+id/area_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Area"
            android:textStyle="bold"
            android:textColor="@color/text_title_2"
            android:textSize="9sp">
        </TextView>
    </LinearLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:text="@string/route_code"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:textStyle="bold"
            android:textColor="@color/text_title"
            android:textSize="9sp">
        </TextView>
        <LinearLayout
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:background="@drawable/button_bg_stroke"
            android:backgroundTint="@color/btn_color_dark">
            <TextView
                android:id="@+id/route_code"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_margin="2dp"
                android:gravity="center"
                android:background="@drawable/button_bg_stroke"
                android:text=""
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="10sp">

            </TextView>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:text="@string/shop_count"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:textStyle="bold"
            android:textColor="@color/text_title"
            android:textSize="9sp">
        </TextView>
        <LinearLayout
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:background="@drawable/button_bg_stroke"
            android:backgroundTint="@color/btn_color_dark">
            <TextView
                android:id="@+id/shop_count"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_margin="2dp"
                android:gravity="center"
                android:background="@drawable/button_bg_stroke"
                android:text=""
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="10sp">

            </TextView>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>