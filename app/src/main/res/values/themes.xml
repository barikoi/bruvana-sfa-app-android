<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.CNLApp" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/cnl_color_1</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="fontFamily">@font/ceraprofontfamily</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.CNLApp.NoActionBar.Material" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="colorPrimary">@color/cnl_color_1</item>
        <item name="colorPrimaryDark">@color/cnl_color_1</item>
        <item name="colorAccent">@color/cnl_color_1</item>
        <item name="editTextColor">@color/white</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <!--<item name="fontFamily">@font/montserratfamily</item>
        <item name="alertDialogTheme">@style/AlertDialogTheme</item>-->
        <item name="colorSurface">@color/white</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="fontFamily">@font/ceraprofontfamily</item>
        <!--<item name="android:listPreferredItemHeightSmall">20dp</item>-->
        <!--<item name="popupMenuBackground">@drawable/rounded_corner_lightgray</item>-->
        <item name="popupMenuStyle">@style/Popup</item>
    </style>


    <style name="Theme.CNLApp.NoActionBar.Material.Dialog" parent="Theme.MaterialComponents.Dialog">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="colorPrimary">@color/cnl_color_1</item>
        <item name="colorPrimaryDark">@color/cnl_color_1</item>
        <item name="colorAccent">@color/cnl_color_1</item>
        <item name="editTextColor">@color/white</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <!--<item name="fontFamily">@font/montserratfamily</item>
        <item name="alertDialogTheme">@style/AlertDialogTheme</item>-->
        <item name="colorSurface">@color/white</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="fontFamily">@font/ceraprofontfamily</item>
        <!--<item name="android:listPreferredItemHeightSmall">20dp</item>-->
        <!--<item name="popupMenuBackground">@drawable/rounded_corner_lightgray</item>-->
        <item name="popupMenuStyle">@style/Popup</item>
    </style>

    <style name="Popup" parent="Widget.AppCompat.PopupMenu">
        <item name="android:listPreferredItemHeightSmall">20dp</item>
        <item name="background">@drawable/rounded_corner_lightgray</item>
        <item name="backgroundTint">@color/white</item>
    </style>

    <style name="spinnerItemStyle">
        <item name="android:textColor">@color/black</item>
        <item name="android:fontFamily">@font/ceraprofontfamily</item>
        <item name="android:textSize">15sp</item>
        <!--<item name="android:hint">@string/select_route</item>-->
    </style>

    <style name="TabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">12sp</item>
        <item name="textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <!--<item name="tabIndicatorHeight">2dp</item>-->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="TabLayoutStyle" parent="Widget.Design.TabLayout">
        <item name="tabPaddingStart">16dp</item>
        <item name="tabPaddingEnd">16dp</item>
        <item name="tabPaddingBottom">0dp</item>
        <item name="tabPaddingTop">0dp</item>
        <item name="tabIndicatorHeight">0dp</item>
        <item name="tabTextAppearance">@style/TabTextAppearance</item>
    </style>

    <style name="ThemeOverlay.App.MaterialCalendar" parent="ThemeOverlay.MaterialComponents.MaterialCalendar.Fullscreen">
        <!-- just override the colors used in the default style -->
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimary">@color/cnl_color_1</item>
    </style>

    <style name="TextInputLayout">
        <item name="android:textColor">#000000</item>
        <!--<item name="colorOnPrimary">@color/cnl_color_1</item>-->
        <item name="android:textColorHint">@color/text_title</item>
        <item name="hintTextColor">@color/text_title</item>
        <item name="colorPrimary">@color/text_title</item>
    </style>

    <style name="AlertDialog" parent="Base.Theme.AppCompat.Light.Dialog">
        <item name="android:textColor">#000000</item>
        <item name="android:textColorPrimary">#595959</item>
        <item name="android:colorAccent" tools:ignore="NewApi">#1b5e20</item>
        <item name="buttonBarNegativeButtonStyle">@style/NegativeButtonStyle</item>
        <item name="buttonBarPositiveButtonStyle">@style/PositiveButtonStyle</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="fontFamily">@font/ceraprofontfamily</item>
    </style>

    <style name="NegativeButtonStyle" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/black</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="PositiveButtonStyle" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="Theme.CNLApp.NoActionBar.nostatusbar" parent="Theme.CNLApp.NoActionBar.Material">
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="fontFamily">@font/ceraprofontfamily</item>
    </style>

    <style name="buttonStyle" parent="Widget.AppCompat.Button.Borderless.Colored">
        <item name="android:background">@color/colorPrimaryDark</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textStyle">bold</item>


    </style>

    <style name="CarterOneText">
        <item name="android:fontFamily">@font/carter_one</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textStyle">bold|italic</item>
    </style>

    <!-- Headline Text Style -->
    <style name="jtiTextHeadline1">
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/luckiest_guy_regular</item>
    </style>
</resources>