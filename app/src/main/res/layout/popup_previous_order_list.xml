<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:cardCornerRadius="10dp"
    android:layout_margin="8dp"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:layout_centerVertical="true"
                android:layout_centerHorizontal="true"
                android:text="Previous Order"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:textSize="15sp">

            </TextView>
            <ImageButton
                android:id="@+id/btnClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                android:background="@color/white"
                android:src="@drawable/ic_cross"
                android:layout_alignParentRight="true">

            </ImageButton>
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/tvcategory"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/ic_category_bg"
                android:layout_margin="16dp"
                android:layout_alignParentStart="true"
                android:translationZ="90dp"
                android:gravity="center"
                android:text=""
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/white">

            </TextView>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/outletName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableLeft="@drawable/ic_shop_small"
                    android:drawablePadding="8dp"
                    android:layout_gravity="center_horizontal"
                    android:text=""
                    android:textStyle="bold"
                    android:textColor="@color/text_title"
                    android:textSize="12sp">

                </TextView>
                <TextView
                    android:id="@+id/lastOrderDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text=""
                    android:textColor="@color/text_title"
                    android:textSize="11sp">

                </TextView>
                <TextView
                    android:id="@+id/lastDeliveryDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text=""
                    android:textColor="@color/text_title"
                    android:textSize="11sp">

                </TextView>
            </LinearLayout>
        </RelativeLayout>



        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp">
            <LinearLayout
                android:id="@+id/layoutStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/button_bg_stroke"
                android:backgroundTint="@color/cnl_color_1">
                <TextView
                    android:id="@+id/tvOrderStatus"
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:layout_margin="2dp"
                    android:paddingRight="16dp"
                    android:paddingLeft="16dp"
                    android:gravity="center"
                    android:background="@drawable/button_bg_stroke"
                    android:text=""
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="10sp">
                </TextView>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/filterLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/rounded_corner_lightgray"
                android:padding="4dp"
                android:gravity="center_vertical"
                android:layout_marginRight="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/filterTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_marginStart="8dp"
                    android:textSize="12sp"
                    android:textColor="@color/text_title"
                    android:text="@string/filter"
                    android:textStyle="bold"
                    android:padding="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_marginRight="4dp"
                    android:layout_marginLeft="8dp">

                </TextView>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_filter"
                    android:layout_marginStart="4dp"
                    app:tint="@color/text_title"
                    android:layout_marginRight="8dp">

                </ImageView>
            </LinearLayout>
        </RelativeLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/productList"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_margin="8dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/single_product_view">

        </androidx.recyclerview.widget.RecyclerView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:padding="2dp"
            android:gravity="center"
            android:background="@drawable/button_bg_stroke"
            android:backgroundTint="@color/cnl_color_2">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:background="@drawable/button_bg_green_stroke"
                android:orientation="horizontal"
                android:gravity="center">
                <TextView
                    android:id="@+id/itemCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 Item"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="12sp">

                </TextView>

                <View
                    android:layout_width="2dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:background="@color/white">

                </View>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/total"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="12sp">

                </TextView>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginRight="4dp"
                    android:layout_marginLeft="4dp"
                    android:src="@drawable/ic_taka"
                    app:tint="@color/white">

                </ImageView>
                <TextView
                    android:id="@+id/grandTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.0"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="12sp">

                </TextView>
            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/minOV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text=""
            android:textStyle="bold"
            android:textColor="@color/text_title"
            android:textSize="13sp">

        </TextView>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnStartOrder"
            android:layout_width="200dp"
            android:layout_height="30dp"
            android:layout_margin="16dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/button_bg_stroke"
            android:backgroundTint="@color/color_gray_medium"
            android:text="@string/start_ordering"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="10sp">

        </androidx.appcompat.widget.AppCompatButton>
    </LinearLayout>

</androidx.cardview.widget.CardView>