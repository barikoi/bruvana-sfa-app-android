<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_margin="8dp"
    android:background="@null">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_20dp"
        android:background="@null"
        android:backgroundTint="@color/white"
        android:orientation="vertical"
        app:cardCornerRadius="15dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/add_gift"
                android:textColor="@color/cnl_color_1"
                android:textSize="17sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:background="@color/color_gray"
                android:layout_marginVertical="@dimen/_5dp"
                android:layout_height="1dp"/>

            <LinearLayout
                android:id="@+id/llCardCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_15dp"
                android:layout_marginBottom="@dimen/_10sdp"
                android:background="@drawable/cardview_bg_stroke_2dp"
                android:orientation="horizontal"
                android:padding="1dp"
                android:layout_gravity="center"
                android:visibility="visible"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/ivGift"
                app:layout_constraintTop_toBottomOf="@+id/tvGiftName">

                <ImageButton
                    android:id="@+id/btnMinus"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/cardview_bg_stroke_2dp"
                    android:backgroundTint="@color/btn_gray_light"
                    android:contentDescription="@string/remove"
                    android:gravity="center_vertical"
                    android:padding="8dp"
                    android:src="@drawable/ic_minus"
                    app:tint="@color/colorPrimaryDark" />

                <EditText
                    android:id="@+id/tvCount"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:autofillHints="NO"
                    android:background="@null"
                    android:ems="4"
                    android:gravity="center"
                    android:inputType="number"
                    android:text="@string/_0"
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:ignore="LabelFor" />

                <ImageButton
                    android:id="@+id/btnPlus"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/cardview_bg_stroke_2dp"
                    android:backgroundTint="@color/btn_gray_light"
                    android:contentDescription="@string/add"
                    android:gravity="center_vertical"
                    android:padding="8dp"
                    android:src="@drawable/ic_plus"
                    app:tint="@color/colorPrimaryDark" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvCaptureImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_18sdp"
                android:layout_marginBottom="@dimen/_8sdp"
                android:gravity="start"
                android:text="@string/capture_photo"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:visibility="visible" />

            <include
                android:id="@+id/llImagePickerView"
                layout="@layout/layout_image_picker" />

            <LinearLayout
                android:id="@+id/buttonLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_18sdp"
                android:gravity="center_horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_no"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_margin="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/cardview_bg"
                    android:backgroundTint="@color/color_gray"
                    android:padding="2dp"
                    android:text="@string/cancel"
                    android:textAllCaps="false"
                    android:textColor="@color/text_title"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_confirm"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_margin="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/cardview_bg"
                    android:backgroundTint="@color/cnl_color_1"
                    android:padding="2dp"
                    android:text="@string/add_gift"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>