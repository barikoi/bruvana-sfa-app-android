<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:layout_margin="4dp"
    android:padding="4dp"
    android:background="@drawable/cardview_bg"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="4"
            android:layout_marginLeft="4dp"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/productName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Product Name"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:textStyle="bold">

            </TextView>

            <TextView
                android:id="@+id/stockCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:visibility="gone"
                android:textColor="@color/text_title"
                android:textSize="9sp">

            </TextView>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tvProductVariation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_marginRight="8dp"
                    android:background="@drawable/button_whitebg_stroke"
                    android:textColor="@color/btn_color_dark"
                    android:text="Jar/box"
                    android:textSize="12sp"/>
                <TextView
                    android:id="@+id/tvPerUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_marginRight="8dp"
                    android:background="@drawable/button_whitebg_stroke"
                    android:textColor="@color/btn_color_dark"
                    android:text="0.0"
                    android:textSize="12sp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:padding="1dp"
                android:orientation="horizontal"
                android:background="@drawable/cardview_bg_stroke_2dp">
                <LinearLayout
                    android:id="@+id/layoutMinus"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"
                    android:gravity="center_vertical"
                    android:background="@drawable/cardview_bg_stroke_2dp"
                    android:backgroundTint="@color/btn_gray_light">
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnminus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/ic_minus">

                    </androidx.appcompat.widget.AppCompatButton>
                </LinearLayout>

                <EditText
                    android:id="@+id/tvCount"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:gravity="center"
                    android:textColor="@color/black"
                    android:text="0"
                    android:textSize="12sp">

                </EditText>
                <LinearLayout
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:padding="4dp"
                    android:background="@drawable/cardview_bg_stroke_2dp"
                    android:backgroundTint="@color/btn_gray_light">
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnPlus"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:padding="4dp"
                        android:background="@drawable/ic_plus">

                    </androidx.appcompat.widget.AppCompatButton>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:background="@drawable/button_bg_stroke"
                android:backgroundTint="@color/btn_color_dark">
                <TextView
                    android:id="@+id/tvSubTotal"
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:layout_margin="2dp"
                    android:gravity="center"
                    android:background="@drawable/button_bg_stroke"
                    android:text="0.0"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="10sp">

                </TextView>
            </LinearLayout>
        </LinearLayout>


    </LinearLayout>

</LinearLayout>