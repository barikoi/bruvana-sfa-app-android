<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/cardview_bg"
    android:backgroundTint="@color/background_card"
    android:layout_marginBottom="8dp"
    android:orientation="vertical"
    android:padding="4dp">
    <LinearLayout
        android:id="@+id/layoutStatus2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        android:layout_centerVertical="true"
        android:background="@drawable/button_bg_stroke"
        android:backgroundTint="@color/cnl_color_1">
        <TextView
            android:id="@+id/tvOrderStatus"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_margin="2dp"
            android:paddingRight="16dp"
            android:paddingLeft="16dp"
            android:gravity="center"
            android:background="@drawable/button_bg_stroke"
            android:text=""
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="10sp">
        </TextView>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/shopLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_margin="8dp">
        <LinearLayout
            android:id="@+id/shopNameLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvShopName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="250dp"
                android:layout_centerVertical="true"
                android:drawableLeft="@drawable/ic_shop_small"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:textColor="@color/black"
                android:text=""
                android:textStyle="bold"
                android:textSize="15sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginRight="4dp" />
            <TextView
                android:id="@+id/tvOrderDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="250dp"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:textColor="@color/black"
                android:text=""
                android:textSize="12sp"
                android:layout_marginRight="4dp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_edit"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:visibility="gone"
            android:background="@drawable/cardview_bg_stroke_2dp"
            android:backgroundTint="@color/white"
            android:padding="2dp"
            android:src="@drawable/ic_edit"
            android:layout_marginLeft="4dp"
            android:layout_alignParentRight="true">

        </ImageView>
    </RelativeLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/productlist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/shopLayout"
        android:padding="4dp"
        android:nestedScrollingEnabled="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/single_confirm_order_product_listview">

    </androidx.recyclerview.widget.RecyclerView>
    <RelativeLayout
        android:id="@+id/bottomLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <LinearLayout
            android:id="@+id/layoutSubTotal"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/button_bg_stroke"
            android:backgroundTint="@color/btn_color_dark">
            <TextView
                android:id="@+id/tvSubTotal"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_margin="2dp"
                android:gravity="center"
                android:background="@drawable/button_bg_stroke"
                android:text="0.0"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="10sp">

            </TextView>
        </LinearLayout>
    </RelativeLayout>


</LinearLayout>