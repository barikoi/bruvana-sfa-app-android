<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".Fragment.so_view.ShopSelectFragment">
    <com.barikoi.cnlapp.Utils.MoreSpinner
        android:id="@+id/spinnerRoutes"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_margin="8dp"
        android:background="@drawable/stroke_background"
        android:theme="@style/spinnerItemStyle"
        tools:ignore="TouchTargetSizeCheck,SpeakableTextPresentCheck">

    </com.barikoi.cnlapp.Utils.MoreSpinner>
    <AutoCompleteTextView
        android:id="@+id/editTextBlock"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_margin="8dp"
        android:padding="4dp"
        android:layout_gravity="center_vertical"
        android:ems="10"
        android:drawableRight="@drawable/ic_search"
        android:drawablePadding="8dp"
        android:drawableTint="@color/color_gray"
        android:hint="Search shop"
        android:imeOptions="actionNext"
        android:inputType="textCapWords"
        android:background="@drawable/stroke_background"
        android:textSize="12sp"
        />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/shoplist"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="vertical"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_below="@+id/topLayout"
        android:scrollbarThumbVertical="@color/black"
        android:background="@color/white"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="2"
        tools:listitem="@layout/single_shop_select_list" />

</LinearLayout>