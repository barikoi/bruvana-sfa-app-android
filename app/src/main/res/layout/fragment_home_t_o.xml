<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:orientation="vertical"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".StatisticsHome.Fragment.SO.HomeFragment">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/bodyLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:gravity="start"
                    android:visibility="gone"
                    android:text="@string/summary"
                    android:textAllCaps="true"
                    android:textColor="@color/text_title"
                    android:textSize="20sp"
                    android:textStyle="bold">

                </TextView>

                <LinearLayout
                    android:id="@+id/dateRangeLayoutHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:layout_marginRight="8dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/stroke_background"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvDateRange"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:layout_marginRight="16dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:drawableLeft="@drawable/ic_date_range"
                        android:drawablePadding="4dp"
                        android:gravity="start"
                        android:text=""
                        android:textColor="@color/text_title_2"
                        android:textSize="14sp">

                    </TextView>
                </LinearLayout>

            </RelativeLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/targetListView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:layout_marginLeft="8dp"
                android:layout_marginBottom="8dp"
                android:layout_marginTop="8dp"
                app:layoutManager="LinearLayoutManager"
                android:orientation="horizontal"
                tools:listitem="@layout/single_summary_view">

            </androidx.recyclerview.widget.RecyclerView>
            <!--active, inactive-->
            <RelativeLayout
                android:id="@+id/layoutSecond"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
                android:orientation="vertical"
                android:visibility="gone"
                android:background="@color/background_app">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:id="@+id/activeLayout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:gravity="start"
                            android:layout_weight="1"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="8dp"
                            android:layout_marginRight="16dp"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp"
                            android:paddingLeft="16dp"
                            android:background="@drawable/rounded_corner_bg_stroke"
                            android:orientation="horizontal">
                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:scaleType="fitXY"
                                android:src="@drawable/ic_present" />
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="8dp"
                                android:layout_marginRight="8dp"
                                android:layout_gravity="center_vertical"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:text="@string/active"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_title"
                                    android:textSize="15sp">

                                </TextView>
                                <TextView
                                    android:id="@+id/activeCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:text=""
                                    android:textStyle="bold"
                                    android:textColor="@color/text_title"
                                    android:textSize="20sp">

                                </TextView>
                            </LinearLayout>

                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/inactiveLayout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:gravity="start"
                            android:layout_margin="8dp"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp"
                            android:layout_weight="1"
                            android:paddingLeft="16dp"
                            android:background="@drawable/rounded_corner_bg_stroke"
                            android:orientation="horizontal">
                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:scaleType="fitXY"
                                android:src="@drawable/ic_absent" />
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="8dp"
                                android:layout_marginRight="8dp"
                                android:layout_gravity="center_vertical"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:text="@string/inactive"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_title"
                                    android:textSize="15sp">

                                </TextView>
                                <TextView
                                    android:id="@+id/inactiveCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:text=""
                                    android:textStyle="bold"
                                    android:textColor="@color/text_title"
                                    android:textSize="20sp">

                                </TextView>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

            </RelativeLayout>
            <!--Live Stock Update-->
            <LinearLayout
                android:id="@+id/layoutThird"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:orientation="vertical"
                android:visibility="gone"
                >
                <TextView
                    android:id="@+id/liveStockUpdate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_centerVertical="true"
                    android:layout_marginBottom="8dp"
                    android:layout_marginTop="8dp"
                    android:gravity="start"
                    android:text="@string/live_stock_update"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:textColor="@color/text_title_blue"
                    android:textSize="20sp"
                    android:textColorLink="@color/text_title_blue"
                    android:layout_alignParentLeft="true">
                </TextView>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/white"
                    android:background="@drawable/rounded_corner_lightgray">

                    <TableLayout
                        android:id="@+id/tabLayout"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/white"
                        android:layout_margin="4dp">
                    </TableLayout>

                </LinearLayout>

            </LinearLayout>
            <!--Last Week Summary-->
            <LinearLayout
                android:id="@+id/layoutFourth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
                android:layout_marginBottom="8dp"
                android:orientation="vertical"
                android:visibility="gone"
                >
                <TextView
                    android:id="@+id/lastweeksummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_centerVertical="true"
                    android:layout_marginBottom="8dp"
                    android:gravity="start"
                    android:text="@string/summary_link"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:textColor="@color/text_title_blue"
                    android:textSize="20sp"
                    android:textColorLink="@color/text_title_blue"
                    android:layout_alignParentLeft="true">
                </TextView>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="35dp"
                    android:orientation="vertical"
                    android:visibility="visible"
                    android:background="@drawable/rounded_corner_lightgray"
                    android:backgroundTint="@color/white">
                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/viewpagertab"
                        style="@style/TabLayoutStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:tabGravity="fill"
                        android:fillViewport="false"
                        android:layout_alignParentTop="true"
                        app:tabBackground="@drawable/tab_indicator_bg_gray"
                        app:tabMinWidth="120dp"
                        app:tabMode="fixed"
                        app:tabSelectedTextColor="@color/white"
                        app:tabTextColor="@color/text_title" />

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/viewPager"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_below="@+id/viewpagertab"
                        android:layout_marginStart="4dp"
                        android:layout_marginLeft="4dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="4dp"
                        android:layout_marginRight="4dp"
                        android:layout_marginBottom="12dp" />

                </RelativeLayout>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/no_route_check"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="gone"
        android:orientation="vertical">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:text="@string/no_route_selected_today"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:textSize="17sp"
            android:textColor="@color/text_title">

        </TextView>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_tryAgain"
            android:layout_width="100dp"
            android:layout_height="36dp"
            android:layout_margin="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_centerHorizontal="true"
            android:background="@drawable/cardview_bg"
            android:backgroundTint="@color/color_gray"
            android:padding="2dp"
            android:textAllCaps="false"
            android:textColor="@color/text_title"
            android:textStyle="bold"
            android:textSize="12sp"
            android:text="@string/refresh" />
    </LinearLayout>

</RelativeLayout>