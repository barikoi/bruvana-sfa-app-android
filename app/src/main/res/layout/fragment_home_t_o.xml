<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:orientation="vertical"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".StatisticsHome.Fragment.SO.HomeFragment">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/bodyLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_marginStart="8dp"
                    android:layout_centerVertical="true"
                    android:gravity="start"
                    android:text="@string/summary"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:textColor="@color/text_title"
                    android:textSize="20sp"
                    android:layout_alignParentLeft="true">
                </TextView>

                <LinearLayout
                    android:id="@+id/dateRangeLayoutHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:layout_marginRight="8dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/stroke_background"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvDateRange"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:layout_marginRight="16dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:drawableLeft="@drawable/ic_date_range"
                        android:drawablePadding="4dp"
                        android:gravity="start"
                        android:text=""
                        android:textColor="@color/text_title_2"
                        android:textSize="14sp">

                    </TextView>
                </LinearLayout>

            </RelativeLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/targetListView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:layout_marginLeft="8dp"
                android:layout_marginBottom="8dp"
                android:layout_marginTop="8dp"
                app:layoutManager="LinearLayoutManager"
                android:orientation="horizontal"
                tools:listitem="@layout/single_summary_view">

            </androidx.recyclerview.widget.RecyclerView>
            <!--active, inactive-->
            <RelativeLayout
                android:id="@+id/layoutSecond"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:orientation="vertical"
                android:visibility="visible"
                android:background="@color/background_app">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:id="@+id/activeLayout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:gravity="start"
                            android:layout_weight="1"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="8dp"
                            android:layout_marginRight="16dp"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp"
                            android:paddingLeft="16dp"
                            android:background="@drawable/rounded_corner_bg_stroke"
                            android:orientation="vertical">
                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_marginTop="4dp"
                                android:layout_marginBottom="8dp"
                                android:scaleType="fitXY"
                                android:src="@drawable/ic_present" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="@string/active"
                                android:textStyle="bold"
                                android:textColor="@color/text_title"
                                android:textSize="15sp">

                            </TextView>
                            <TextView
                                android:id="@+id/activeCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text=""
                                android:textStyle="bold"
                                android:textColor="@color/text_title"
                                android:textSize="20sp">

                            </TextView>
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/inactiveLayout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:gravity="start"
                            android:layout_margin="8dp"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp"
                            android:layout_weight="1"
                            android:paddingLeft="16dp"
                            android:background="@drawable/rounded_corner_bg_stroke"
                            android:orientation="vertical">
                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_marginTop="4dp"
                                android:layout_marginBottom="8dp"
                                android:scaleType="fitXY"
                                android:src="@drawable/ic_absent" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="@string/inactive"
                                android:textStyle="bold"
                                android:textColor="@color/text_title"
                                android:textSize="15sp">

                            </TextView>
                            <TextView
                                android:id="@+id/inactiveCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text=""
                                android:textStyle="bold"
                                android:textColor="@color/text_title"
                                android:textSize="20sp">

                            </TextView>
                        </LinearLayout>
                    </LinearLayout>

            </RelativeLayout>
            <!--Live Stock Update-->
            <LinearLayout
                android:id="@+id/layoutThird"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:orientation="vertical"
                android:visibility="visible"
                >
                <TextView
                    android:id="@+id/liveStockUpdate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_centerVertical="true"
                    android:layout_marginBottom="8dp"
                    android:layout_marginTop="8dp"
                    android:gravity="start"
                    android:text="@string/live_stock_update"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:textColor="@color/text_title_blue"
                    android:textSize="20sp"
                    android:textColorLink="@color/text_title_blue"
                    android:layout_alignParentLeft="true">
                </TextView>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/white"
                    android:background="@drawable/rounded_corner_lightgray">

                    <TableLayout
                        android:id="@+id/tabLayout"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/white"
                        android:layout_margin="4dp">
                    </TableLayout>

                </LinearLayout>

            </LinearLayout>
            <!--Last Week Summary-->
            <LinearLayout
                android:id="@+id/layoutFourth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:orientation="vertical"
                android:visibility="visible"
                >
                <TextView
                    android:id="@+id/lastweeksummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_centerVertical="true"
                    android:layout_marginBottom="8dp"
                    android:layout_marginTop="8dp"
                    android:gravity="start"
                    android:text="@string/last_week_summary_link"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:textColor="@color/text_title_blue"
                    android:textSize="20sp"
                    android:textColorLink="@color/text_title_blue"
                    android:layout_alignParentLeft="true">
                </TextView>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/white"
                    android:orientation="vertical"
                    android:background="@drawable/rounded_corner_lightgray">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_margin="8dp"
                        android:padding="12dp"
                        android:background="@drawable/rounded_corner_bg_stroke">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="2dp"
                                android:layout_marginStart="4dp"
                                android:layout_centerVertical="true"
                                android:gravity="start"
                                android:text="@string/ov"
                                android:textStyle="bold"
                                android:textAllCaps="true"
                                android:textColor="@color/cnl_color_1"
                                android:textSize="16sp"
                                android:layout_alignParentLeft="true">
                            </TextView>
                            <TextView
                                android:id="@+id/ovCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="4dp"
                                android:layout_marginStart="2dp"
                                android:layout_centerVertical="true"
                                android:gravity="start"
                                android:text=""
                                android:textStyle="bold"
                                android:textAllCaps="true"
                                android:textColor="@color/text_title"
                                android:textSize="16sp"
                                android:layout_alignParentLeft="true">
                            </TextView>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="2dp"
                                android:layout_marginStart="4dp"
                                android:layout_centerVertical="true"
                                android:gravity="start"
                                android:text="@string/bpc"
                                android:textStyle="bold"
                                android:textAllCaps="true"
                                android:textColor="@color/cnl_color_1"
                                android:textSize="16sp"
                                android:layout_alignParentLeft="true">
                            </TextView>
                            <TextView
                                android:id="@+id/bpcCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="4dp"
                                android:layout_marginStart="2dp"
                                android:layout_centerVertical="true"
                                android:gravity="start"
                                android:text=""
                                android:textStyle="bold"
                                android:textAllCaps="true"
                                android:textColor="@color/text_title"
                                android:textSize="16sp"
                                android:layout_alignParentLeft="true">
                            </TextView>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="2dp"
                                android:layout_marginStart="4dp"
                                android:layout_centerVertical="true"
                                android:gravity="start"
                                android:text="@string/lpc"
                                android:textStyle="bold"
                                android:textAllCaps="true"
                                android:textColor="@color/cnl_color_1"
                                android:textSize="16sp"
                                android:layout_alignParentLeft="true">
                            </TextView>
                            <TextView
                                android:id="@+id/lpcCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="4dp"
                                android:layout_marginStart="2dp"
                                android:layout_centerVertical="true"
                                android:gravity="start"
                                android:text=""
                                android:textStyle="bold"
                                android:textAllCaps="true"
                                android:textColor="@color/text_title"
                                android:textSize="16sp"
                                android:layout_alignParentLeft="true">
                            </TextView>
                        </LinearLayout>
                    </LinearLayout>
                    <TableLayout
                        android:id="@+id/tabLayout2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/white"
                        android:layout_margin="4dp">
                    </TableLayout>

                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/no_route_check"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="gone"
        android:orientation="vertical">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:text="@string/no_route_selected_today"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:textSize="17sp"
            android:textColor="@color/text_title">

        </TextView>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_tryAgain"
            android:layout_width="100dp"
            android:layout_height="36dp"
            android:layout_margin="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_centerHorizontal="true"
            android:background="@drawable/cardview_bg"
            android:backgroundTint="@color/color_gray"
            android:padding="2dp"
            android:textAllCaps="false"
            android:textColor="@color/text_title"
            android:textStyle="bold"
            android:textSize="12sp"
            android:text="@string/try_again" />
    </LinearLayout>

</RelativeLayout>