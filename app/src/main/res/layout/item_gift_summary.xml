<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_5dp"
    android:background="@drawable/rounded_stroke_gift"
    android:padding="@dimen/_15dp">

    <TextView
        android:id="@+id/tvGiftTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gift Box"
        android:textColor="@color/text_title"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="32"
        android:padding="@dimen/_8sdp"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:layout_marginEnd="@dimen/_15dp"
        android:backgroundTint="@color/cnl_color_1"
        android:background="@drawable/rounded_stroke_gift"
        app:layout_constraintEnd_toStartOf="@+id/ivExpend"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ivExpend"
        android:layout_width="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:src="@drawable/ic_arrow_drop_down"
        android:layout_height="wrap_content" />

</androidx.constraintlayout.widget.ConstraintLayout>