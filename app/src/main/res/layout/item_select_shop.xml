<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_5dp"
    android:background="@drawable/cardview_bg"
    android:padding="@dimen/_10sdp">

    <RelativeLayout
        android:id="@+id/llShopImage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:background="@drawable/ic_category_bg"
            android:gravity="center"
            android:text=""
            android:textColor="@color/white"
            android:textSize="9sp"
            android:textStyle="bold"
            android:translationZ="90dp"
            android:visibility="gone"
            tools:ignore="SmallSp" />

        <androidx.cardview.widget.CardView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:background="@color/white"
            android:gravity="center"
            android:visibility="visible"
            app:cardCornerRadius="10dp">

            <ImageView
                android:id="@+id/imageShop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/shop_image"
                android:scaleType="fitXY"
                android:src="@drawable/shop" />

        </androidx.cardview.widget.CardView>
    </RelativeLayout>


    <TextView
        android:id="@+id/tvShopName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_10sdp"
        android:layout_toStartOf="@+id/isOrderView"
        android:text="Hello Shop"
        android:textColor="@color/black"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/isOrderView"
        app:layout_constraintStart_toEndOf="@+id/llShopImage"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvOwnerName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_10sdp"
        android:text="Hello Owner"
        android:textColor="@color/text_title"
        android:textSize="9sp"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@+id/isOrderView"
        app:layout_constraintStart_toEndOf="@+id/llShopImage"
        app:layout_constraintTop_toBottomOf="@+id/tvShopName"
        tools:ignore="SmallSp" />

    <TextView
        android:id="@+id/orderDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_10sdp"
        android:text="dssdsdds"
        android:textColor="@color/text_title_2"
        android:textSize="9sp"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@+id/isOrderView"
        app:layout_constraintStart_toEndOf="@+id/llShopImage"
        app:layout_constraintTop_toBottomOf="@+id/tvOwnerName"
        tools:ignore="SmallSp" />

    <TextView
        android:id="@+id/tvOutletId"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_5dp"
        android:drawableStart="@drawable/ic_shop_small"
        android:drawablePadding="@dimen/_5dp"
        android:textColor="@color/text_title_2"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/isOrderView"
        app:layout_constraintStart_toEndOf="@+id/llShopImage"
        app:layout_constraintTop_toBottomOf="@+id/tvOwnerName"
        tools:ignore="SmallSp" />

    <TextView
        android:id="@+id/tvOutletType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_5dp"
        android:textColor="@color/text_title"
        android:textSize="9sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@+id/llShopImage"
        app:layout_constraintTop_toBottomOf="@+id/tvOutletId"
        tools:ignore="SmallSp" />

    <ImageView
        android:id="@+id/isOrderView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="@dimen/_3sdp"
        android:contentDescription="@string/order_complete_image"
        android:src="@drawable/ic_ordered"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnDetails"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnDetails"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_margin="2dp"
        android:background="@drawable/button_bg_stroke"
        android:text="@string/details"
        android:textColor="@color/white"
        android:textSize="10sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="SmallSp" />

</androidx.constraintlayout.widget.ConstraintLayout>