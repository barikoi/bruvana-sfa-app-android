<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="200dp"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="start"
    android:layout_marginRight="8dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:background="@drawable/rounded_corner_lightgray"
    android:backgroundTint="@color/card_blue"
    android:orientation="vertical">
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Total Target"
            android:textStyle="bold"
            android:textColor="@color/text_title"
            android:textSize="14sp">

        </TextView>
        <TextView
            android:id="@+id/targetedAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:text="10000"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:textSize="30sp">

        </TextView>
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressBar"
        android:layout_height="match_parent"
        android:layout_width="match_parent"
        android:layout_marginEnd="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:indeterminate="false"
        app:trackColor="@color/progress_track"
        app:trackThickness="8dp"
        app:trackCornerRadius="10dp"
        android:progress="0"
        app:indicatorColor="@color/white"
        />

    <TextView
        android:id="@+id/completeAmount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="73000"
        android:textStyle="bold"
        android:textColor="@color/progress_track"
        android:textSize="14sp">
    </TextView>
    </LinearLayout>