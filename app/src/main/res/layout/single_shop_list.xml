<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cardview_bg"
    android:backgroundTint="@color/white"
    android:padding="4dp"
    android:weightSum="5"
    android:layout_margin="8dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/imgNewTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:scaleType="fitXY"
                android:visibility="gone"
                android:translationZ="90dp"
                android:src="@drawable/ic_new_tag" />
            <androidx.cardview.widget.CardView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:gravity="center"
                android:layout_margin="4dp"
                app:cardCornerRadius="10dp"
                android:visibility="visible"
                android:background="@color/white">
                <ImageView
                    android:id="@+id/imageShop"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/shop" />

            </androidx.cardview.widget.CardView>
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_toLeftOf="@+id/btn_edit"
                    android:orientation="horizontal">
                <TextView
                    android:id="@+id/shop_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="5"
                    android:drawableLeft="@drawable/ic_shop_small"
                    android:drawablePadding="8dp"
                    android:layout_margin="4dp"
                    android:inputType="textMultiLine"
                    android:text=""
                    android:textColor="@color/text_title"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <ImageView
                    android:id="@+id/shop_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight=".5"
                    android:layout_marginLeft="4dp"
                    android:visibility="gone"
                    android:src="@drawable/ic_dot"
                    android:tint="@color/cnl_color_2">

                </ImageView>
                </LinearLayout>
                <ImageView
                    android:id="@+id/btn_edit"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="4dp"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/cardview_bg_stroke_2dp"
                    android:backgroundTint="@color/white"
                    android:padding="2dp"
                    android:visibility="visible"
                    android:src="@drawable/ic_edit"
                    android:layout_marginLeft="4dp">

                </ImageView>
            </RelativeLayout>

            <TextView
                android:id="@+id/address"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableLeft="@drawable/ic_location_shop"
                android:drawablePadding="8dp"
                android:layout_margin="4dp"
                android:text=""
                android:textColor="@color/text_title_2"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/distributor_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableLeft="@drawable/ic_owner"
                android:drawablePadding="8dp"
                android:layout_margin="4dp"
                android:visibility="gone"
                android:text="distributor"
                android:textColor="@color/text_title_2"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/shop_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableLeft="@drawable/ic_shop_small"
                android:drawablePadding="8dp"
                android:layout_margin="4dp"
                android:text=""
                android:textColor="@color/text_title_2"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/shop_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:text=""
                android:textColor="@color/text_title_2"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:background="@drawable/button_bg_green_stroke"
                android:backgroundTint="@color/cnl_color_2">
                <TextView
                    android:id="@+id/shop_type"
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:layout_margin="2dp"
                    android:gravity="center"
                    android:background="@drawable/button_bg_green_stroke"
                    android:text="Shop Type"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="10sp">

                </TextView>
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:background="@drawable/button_bg_stroke"
                android:backgroundTint="@color/btn_color_dark">
                <TextView
                    android:id="@+id/territory_name"
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:layout_margin="2dp"
                    android:gravity="center"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:background="@drawable/button_bg_stroke"
                    android:text="Territory Name"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="10sp">

                </TextView>
            </LinearLayout>
        </LinearLayout>
</LinearLayout>